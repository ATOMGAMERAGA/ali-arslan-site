# ─────────────────────────────────────────────────────────────────────────────
#  Ali Arslan — okuryazar.blog · ortam degiskenleri
#
#  Sunucuda bu dosyanin gercek hali /etc/okuryazar/blog.env icinde durur ve
#  izinleri 600'dur (yalnizca root okuyabilir). Bu ornek dosya git'e girer,
#  gercek dosya ASLA girmez.
#  deploy/kurulum.sh bu dosyayi sizin yerinize olusturur.
# ─────────────────────────────────────────────────────────────────────────────

# Uygulamanin dinledigi adres. nginx onunde durdugu icin yalnizca localhost.
HOST=127.0.0.1
PORT=3000
NODE_ENV=production

# Sitenin genel adresi (paylasim baglantilari, sitemap, RSS ve OpenGraph icin).
SITE_URL=https://okuryazar.blog
SITE_NAME=Ali Arslan
SITE_TITLE=Ali Arslan — Edebiyat
SITE_DESC=Tarih okumalari, arastirmalar ve gecmisin bugune biraktigi izler.

# Oturum imzalama anahtari. En az 32 rastgele bayt olmali.
#   openssl rand -base64 48
SESSION_SECRET=degistirin-openssl-rand-base64-48

# HTTPS arkasindaysaniz 1 birakin (cerezler Secure isaretlenir).
SECURE_COOKIES=1

# nginx'in gercek ziyaretci IP'sini X-Forwarded-For ile ilettigi proxy sayisi.
TRUST_PROXY=1

# Verilerin durdugu dizin: blog.sqlite ve yuklenen gorseller burada.
DATA_DIR=/var/lib/okuryazar

# Giris/cikis ve basarisiz deneme kayitlari (fail2ban bu dosyayi izler).
AUTH_LOG=/var/log/okuryazar/auth.log

# Ilk kurulumda olusturulacak yonetici. Kullanici olustuktan sonra bu iki
# satiri silebilirsiniz; sifre veritabaninda yalnizca scrypt ozeti olarak durur.
ADMIN_USER=aliarslan
ADMIN_PASS=Arslan1324!

# Tasarim ayarlari (Claude Design'daki props karsiliklari)
# varsayilan tema: sistem | acik | koyu
VARSAYILAN_TEMA=sistem
# yazi listesinde "x dk okuma" gosterilsin mi
OKUMA_SURESI_GOSTER=1
# kapak gorsellerine sepya/arsiv tonu uygulansin mi
KAPAKLAR_SEPYA=1

# Yuklenebilecek en buyuk gorsel (MB)
MAX_UPLOAD_MB=12
